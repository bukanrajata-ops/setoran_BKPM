          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nim\": \"23001\",\n  \"nama\": \"Budi\",\n  \"email\": \"budi@gmail.com\",\n  \"prodi_id\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
